# eStorage - Пример файла переменных окружения
# Скопируйте этот файл в .env и настройте значения под ваше окружение
# ВАЖНО: Никогда не коммитьте файл .env в репозиторий!

# ============================================
# ОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ
# ============================================

# Секретный ключ Django
# Сгенерируйте новый ключ командой:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your_secret_key_here

# Режим отладки (True для разработки, False для production)
DEBUG=True

# Разрешенные хосты (через запятую, без пробелов)
ALLOWED_HOSTS=127.0.0.1,localhost

# ============================================
# НАСТРОЙКИ БАЗЫ ДАННЫХ
# ============================================

# Для SQLite (по умолчанию, для разработки) - оставьте пустым
# Для PostgreSQL - раскомментируйте и настройте:

# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=estorage
# DB_USER=estorage_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432

# ============================================
# НАСТРОЙКИ REDIS (опционально)
# ============================================

# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=1

# ============================================
# НАСТРОЙКИ БЕЗОПАСНОСТИ (для production)
# ============================================

# Включить редирект на HTTPS (только для production с SSL)
# SECURE_SSL_REDIRECT=False

# Безопасные cookies (только для production с HTTPS)
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False

# ============================================
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ
# ============================================

# Email настройки (если требуется отправка email)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password

# Настройки прокси для загрузки файлов (опционально)
# PROXY_URL=https://api.allorigins.win/raw?url=
